# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key-here

# Supabase Secret Key (Server-side only - DO NOT expose in client code)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key-here

# Backend API Configuration
PORT=3001
NODE_ENV=production

# CORS Configuration
CORS_ORIGIN=https://your-frontend-domain.vercel.app

# Security
JWT_SECRET=your-jwt-secret-key-here

# Database (if using additional database)
DATABASE_URL=your-database-url-here

# Optional: Analytics and Monitoring
ANALYTICS_ID=your-analytics-id
SENTRY_DSN=your-sentry-dsn